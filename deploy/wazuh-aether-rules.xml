<group name="aether,">
  <rule id="110320" level="0">
    <decoded_as>json</decoded_as>
    <field name="schema" type="pcre2">^aether\.security_event\.v1$</field>
    <description>AetherAV security event</description>
  </rule>
  <rule id="110321" level="10">
    <if_sid>110320</if_sid>
    <field name="rule_id" type="pcre2">^ssh\.(distributed_account_failures|login_after_failures)$</field>
    <description>AetherAV correlated SSH activity</description>
  </rule>
  <rule id="110322" level="12">
    <if_sid>110320</if_sid>
    <field name="severity" type="pcre2">^malicious$</field>
    <description>AetherAV malicious finding</description>
  </rule>
  <rule id="110323" level="5">
    <if_sid>110320</if_sid>
    <field name="rule_id" type="pcre2">^ssh\.(multi_host_source|password_spray)$</field>
    <description>AetherAV SSH activity across accounts or servers</description>
  </rule>
</group>
